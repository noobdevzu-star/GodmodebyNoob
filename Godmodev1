-- 7. GODMODE XỊN (Nhân bản Humanoid đánh lừa Server)
local godmodeEnabled = false

local function updateGodmode(state)
    local char = Player.Character
    if not char then return end

    if state then
        -- Kỹ thuật nhân bản Humanoid để cắt đứt liên kết sát thương với Server
        local oldHum = char:FindFirstChildOfClass("Humanoid")
        if oldHum then
            local newHum = oldHum:Clone()
            newHum.Parent = char
            oldHum:Destroy() -- Phá hủy Humanoid gốc
            
            workspace.CurrentCamera.CameraSubject = newHum
            Player.Character = char
            
            -- Buff máu lên vô hạn
            newHum.MaxHealth = math.huge
            newHum.Health = math.huge
            
            -- Vô hiệu hóa trạng thái chết
            newHum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        end
    else
        -- Khi tắt, bắt buộc phải Reset nhân vật để server tải lại Humanoid chuẩn
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Health = 0
        end
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    godmodeEnabled = not godmodeEnabled
    if godmodeEnabled then
        ToggleBtn.Text = "🟢 Godmode: ĐANG BẬT"
        ToggleBtn.TextColor3 = Color3.fromRGB(75, 255, 75)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        updateGodmode(true)
    else
        ToggleBtn.Text = "🔴 Godmode: TẮT"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 75, 75)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        updateGodmode(false)
    end
end)

-- Tự động bật lại Godmode nếu chuyển map hoặc bị buộc reset
