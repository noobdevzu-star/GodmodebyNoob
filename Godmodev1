-- 7. CƠ CHẾ BẤT TỬ ĐA TẦNG (Không bị trừ máu / Chống Killbrick)
local isGodmode = false
local connections = {}

local function applyDefense(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 3)
    if not humanoid then return end

    -- Ngăn trạng thái chết
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)

    -- Lớp 1: Khóa sự kiện thay đổi máu (Khôi phục ngay khi bị trừ)
    local healthConn = humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if isGodmode and humanoid.Health < humanoid.MaxHealth then
            humanoid.Health = humanoid.MaxHealth
        end
    end)
    table.insert(connections, healthConn)

    -- Lớp 2: Xóa TouchInterest trên các bộ phận để bẫy không nhận diện được
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            for _, child in pairs(part:GetChildren()) do
                if child:IsA("TouchTransmitter") then
                    child:Destroy()
                end
            end
        end
    end

    -- Lớp 3: Liên tục giữ máu tối đa qua RenderStepped
    local stepConn = RunService.RenderStepped:Connect(function()
        if isGodmode and humanoid then
            humanoid.Health = humanoid.MaxHealth
        end
    end)
    table.insert(connections, stepConn)
end

local function cleanDefense()
    for _, conn in pairs(connections) do
        if conn then conn:Disconnect() end
    end
    connections = {}
    
    local char = Player.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
