-- Tự động đổi Torso/UpperTorso tùy theo cấu trúc nhân vật
local function getNeckPart(char)
    if char:FindFirstChild("UpperTorso") then return "UpperTorso" end
    if char:FindFirstChild("Torso") then return "Torso" end
    return "Head"
end

local function getClosestPlayer()
    local closest = nil
    local shortestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local targetNode = aimPart == "Head" and "Head" or getNeckPart(p.Character)
            local targetObj = p.Character:FindFirstChild(targetNode)
            
            if targetObj then
                local pos, onScreen = Camera:WorldToViewportPoint(targetObj.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = p
                    end
                end
            end
        end
    end
    return closest
end

-- Vòng lặp chính xử lý ESP & Aimbot
RunService.RenderStepped:Connect(function()
    -- 1. ESP (Phát sáng viền đỏ Free Fire)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            if isESP and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                if not p.Character:FindFirstChild("FF_ESP") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "FF_ESP"
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.Parent = p.Character
                end
            else
                local hl = p.Character:FindFirstChild("FF_ESP")
                if hl then hl:Destroy() end
            end
        end
    end

    -- 2. Aimbot & Auto-Shoot
    if isAimbot then
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or isAimbot then
            local target = getClosestPlayer()
            if target and target.Character then
                local targetNode = aimPart == "Head" and "Head" or getNeckPart(target.Character)
                local aimObj = target.Character:FindFirstChild(targetNode)
                
                if aimObj then
                    -- Khóa tâm vào mục tiêu (Aimlock)
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimObj.Position)
                    
                    -- Tự động bóp cò (Auto-Shoot)
                    if isAutoShoot and mouse1click then
                        mouse1click()
                    end
                end
            end
        end
    end
end)

-- Sự kiện click các nút
local function toggleButton(btn, state, textOff, textOn)
    if state then
        btn.Text = "🟢 " .. textOn
        btn.TextColor3 = Color3.fromRGB(75, 255, 75)
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    else
        btn.Text = "🔴 " .. textOff
        btn.TextColor3 = Color3.fromRGB(255, 75, 75)
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    end
end

