-- 7. GODMODE XỊN (Vô hiệu hóa cái chết + Bơm máu liên tục)
local godmodeEnabled = false
local godmodeLoop = nil

local function updateGodmode(state)
    local char = Player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    
    if state then
        if hum then
            -- Chống game nhận diện nhân vật đã chết
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        end
        -- Dùng vòng lặp siêu tốc bơm máu để chống sát thương theo thời gian (Tick damage)
        if not godmodeLoop then
            godmodeLoop = RunService.Heartbeat:Connect(function()
                local c = Player.Character
                local h = c and c:FindFirstChild("Humanoid")
                if h then
                    h.MaxHealth = math.huge
                    h.Health = math.huge
                end
            end)
        end
    else
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
            hum.MaxHealth = 100
            hum.Health = 100
        end
        if godmodeLoop then
            godmodeLoop:Disconnect()
            godmodeLoop = nil
        end
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    godmodeEnabled = not godmodeEnabled
    if godmodeEnabled then
        ToggleBtn.Text = "🟢 Godmode: ĐANG BẬT"
        ToggleBtn.TextColor3 = Color3.fromRGB(75, 255, 75)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        updateGodmode(true)
    else
        ToggleBtn.Text = "🔴 Godmode: TẮT"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 75, 75)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        updateGodmode(false)
    end
end)

-- Tự bật lại Godmode nếu reset hoặc chuyển map
Player.CharacterAdded:Connect(function(char)
    if godmodeEnabled then
        char:WaitForChild("Humanoid")
        updateGodmode(true)
    end
end)
