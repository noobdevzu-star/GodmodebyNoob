-- 7. CƠ CHẾ BẤT TỬ TUYỆT ĐỐI (ANTI-TOUCH & ANTI-SERVER)
local isGodmode = false
local connections = {}

local function applyAbsoluteGodmode(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 3)
    if not hum then return end

    -- Lớp 1: Bẻ gãy liên kết nhận sát thương từ máy chủ bằng cách tráo Humanoid
    hum.Name = "FakeHum"
    local realHum = hum:Clone()
    realHum.Name = "Humanoid"
    realHum.Parent = char
    hum:Destroy()

    workspace.CurrentCamera.CameraSubject = realHum

    -- Khởi động lại hoạt ảnh để nhân vật không bị đơ
    local animate = char:FindFirstChild("Animate")
    if animate then
        animate.Disabled = true
        task.wait(0.1)
        animate.Disabled = false
    end

    -- Lớp 2: Xóa toàn bộ điểm tiếp xúc (Bẫy, kiếm, đạn chạm vào sẽ xuyên qua)
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("TouchTransmitter") then
            v:Destroy()
        end
    end

    -- Khóa máu ở mức vô cực
    realHum.MaxHealth = 999999999
    realHum.Health = 999999999
    realHum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)

    -- Lớp 3: Bơm máu lại ngay lập tức mỗi khung hình
    local stepConn = RunService.Heartbeat:Connect(function()
        if realHum then
            realHum.Health = 999999999
        end
    end)
    table.insert(connections, stepConn)

    -- Lớp 4: Xóa liên tục các điểm chạm mới sinh ra (Ví dụ khi bạn cầm vũ khí mới)
    local childConn = char.DescendantAdded:Connect(function(v)
        if v:IsA("TouchTransmitter") then
            task.wait()
            v:Destroy()
        end
    end)
    table.insert(connections, childConn)
end

local function cleanDefense()
    for _, conn in pairs(connections) do
        if conn then conn:Disconnect() end
    end
    connections = {}
    
    local char = Player.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.Health = 0 -- Ép chết để game reset lại cơ thể bình thường
    end
end

