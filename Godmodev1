-- HÀM HỖ TRỢ
local function getNeckPart(char)
    if char:FindFirstChild("UpperTorso") then return "UpperTorso" end
    if char:FindFirstChild("Torso") then return "Torso" end
    return "Head"
end

local function getClosestPlayer()
    local closest = nil
    local shortestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            pcall(function()
                if p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local targetNode = states.AimPart == "Head" and "Head" or getNeckPart(p.Character)
                    local targetObj = p.Character:FindFirstChild(targetNode)
                    if targetObj then
                        local pos, onScreen = Camera:WorldToViewportPoint(targetObj.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                            if dist < shortestDist then shortestDist = dist closest = p end
                        end
                    end
                end
            end)
        end
    end
    return closest
end

-- VÒNG LẶP CHÍNH (Đã bọc Pcall chống crash)
RunService.RenderStepped:Connect(function()
    -- 1. Xử lý bản thân
    pcall(function()
        local char = Player.Character
        if states.Godmode and char and char:FindFirstChild("Humanoid") then
            char.Humanoid.MaxHealth = math.huge
            char.Humanoid.Health = math.huge
        end
        
        if states.Obby and char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanTouch = false end
            end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root and root.Position.Y < workspace.FallenPartsDestroyHeight + 50 then
                root.CFrame = root.CFrame + Vector3.new(0, 150, 0)
            end
        end
    end)

    -- 2. Xử lý kẻ địch (ESP / Hitbox)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player then
            pcall(function()
                local char = p.Character
                if char then
                    if states.Hitbox and char:FindFirstChild("HumanoidRootPart") then
                        char.HumanoidRootPart.Size = Vector3.new(25, 25, 25)
                        char.HumanoidRootPart.Transparency = 0.7
                        char.HumanoidRootPart.CanCollide = false
                    end
                    
                    if states.ESP and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                        if not char:FindFirstChild("FF_ESP") then
                            local hl = Instance.new("Highlight")
                            hl.Name = "FF_ESP"
                            hl.FillColor = Color3.fromRGB(255, 0, 0)
                            hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                            hl.FillTransparency = 0.5
                            hl.Parent = char
                        end
                    else
                        local hl = char:FindFirstChild("FF_ESP")
                        if hl then hl:Destroy() end
                    end
                end
            end)
        end
    end

    -- 3. Xử lý Aimbot & AutoShoot
    pcall(function()
        if states.Aimbot then
            local target = getClosestPlayer()
            if target and target.Character then
                local targetNode = states.AimPart == "Head" and "Head" or getNeckPart(target.Character)
                local aimObj = target.Character:FindFirstChild(targetNode)
                if aimObj then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimObj.Position)
                    -- Chỉ chạy mouse1click nếu phần mềm Executor hỗ trợ
                    if states.AutoShoot and typeof(mouse1click) == "function" then 
                        mouse1click() 
                    end
                end
            end
        end
    end)
end)

