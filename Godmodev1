local function createButton(textOff)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 220, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.Text = "🔴 " .. textOff
    btn.Font = Enum.Font.GothamBold
    btn.TextColor3 = Color3.fromRGB(255, 75, 75)
    btn.TextSize = 14
    btn.Parent = ScrollFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 2; stroke.Color = Color3.fromRGB(255, 255, 255)
    return btn
end

local function toggleUI(btn, state, textOff, textOn)
    if state then
        btn.Text = "🟢 " .. textOn
        btn.TextColor3 = Color3.fromRGB(75, 255, 75)
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    else
        btn.Text = "🔴 " .. textOff
        btn.TextColor3 = Color3.fromRGB(255, 75, 75)
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    end
end

